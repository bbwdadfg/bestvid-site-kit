<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.clojars.tianwei</groupId>
  <artifactId>bestvid-site-kit</artifactId>
  <version>0.1.6</version>
  <packaging>jar</packaging>

  <name>BestVid Site Kit</name>
  <description>Small URL helpers for BestVid links.</description>
  <url>https://bestvid.net</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>BestVid</name>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/bbwdadfg/bestvid-site-kit</url>
    <connection>scm:git:https://github.com/bbwdadfg/bestvid-site-kit.git</connection>
    <developerConnection>scm:git:https://github.com/bbwdadfg/bestvid-site-kit.git</developerConnection>
    <tag>v0.1.6</tag>
  </scm>

  <distributionManagement>
    <repository>
      <id>clojars</id>
      <url>https://repo.clojars.org</url>
    </repository>
  </distributionManagement>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.14.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>
</project>
